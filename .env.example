# Use the same JWT_SECRET as the Mottainai API and the same Redis password.
REDIS_URL=redis://:SUA_REDIS_PASSWORD@redis:6379/0
JWT_SECRET=use_um_segredo_com_no_minimo_32_caracteres
JWT_ALGORITHM=HS256
# Server-to-server publisher secret (at least 32 random characters).
NOTIFICATION_PUBLISHER_SECRET=replace_with_a_random_secret_of_at_least_32_chars
